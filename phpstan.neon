includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
	level: 9
	paths:
		- uri
		- components
		- interfaces
		- polyfill
	ignoreErrors:
		- identifier: missingType.iterableValue
		- '#deprecated class League\\Uri\\BaseUri#'
		- '#deprecated interface League\\Uri\\Contracts\\UriAccess#'
		-
		  message: '#Call to deprecated method fromBaseUri\(\) of class#'
		  path: uri/FactoryTest.php
		-
		  identifier: binaryOp.invalid
		  path: interfaces/IPv4/NativeCalculator.php
		-
		  identifier: cast.string
		  path: interfaces/IPv4/NativeCalculator.php
		-
		  identifier: argument.type
		  path: interfaces/IPv4/BCMathCalculator.php
		-
		  identifier: cast.string
		  path: interfaces/IPv4/BCMathCalculator.php
		-
		  identifier: argument.type
		  path: interfaces/IPv4/GMPCalculator.php
		-
		  identifier: binaryOp.invalid
		  path: interfaces/IPv4/Converter.php
	reportUnmatchedIgnoredErrors: true
	treatPhpDocTypesAsCertain: false
