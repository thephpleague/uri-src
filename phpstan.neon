includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
	level: 9
	paths:
		- uri
		- components
		- interfaces
		- polyfill
	ignoreErrors:
		- identifier: missingType.iterableValue
		-
		  identifier: binaryOp.invalid
		  paths:
		    - interfaces/IPv4/NativeCalculator.php
		    - interfaces/IPv4/Converter.php
		-
		  identifier: cast.string
		  paths:
		    - interfaces/IPv4/NativeCalculator.php
		    - interfaces/IPv4/BCMathCalculator.php
		-
		  identifier: argument.type
		  paths:
		    - interfaces/IPv4/BCMathCalculator.php
		    - interfaces/IPv4/GMPCalculator.php
		-
		   identifier: staticMethod.deprecated
		   path: uri/FactoryTest.php
		-
		   identifier: method.deprecatedClass
		   path: uri/BaseUriTest.php
		-
		   identifier: staticMethod.deprecatedClass
		   path: uri/BaseUriTest.php
		-
		   identifier: classConstant.deprecatedClass
		   path: uri/BaseUriTest.php
		-
		   identifier: class.implementsDeprecatedInterface
		   path: components/Modifier.php
		-
		   message: '#Call to deprecated method expectExceptionMessage\(\) of class PHPUnit\\Framework\\TestCase:#'
	reportUnmatchedIgnoredErrors: true
	treatPhpDocTypesAsCertain: false
	parallel:
		processTimeout: 300.0
